# ── Gemini ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── GitHub OAuth App ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:8000
# Callback URL: http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ── GitHub PAT (fallback for CLI use without OAuth) ─────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your_github_username

# ── Supabase ────────────────────────────────────────────────────────────────────
# Create a free project at: https://supabase.com
# URL + anon key from: Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── Job Platforms (credentials stay local, never committed) ─────────────────────
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=

INDEED_EMAIL=your@email.com
INDEED_PASSWORD=

# ── Target Profile Defaults ─────────────────────────────────────────────────────
TARGET_ROLE=AI Engineer
TARGET_MARKET=India
TARGET_NICHE=MLOps

# ── App Behaviour ───────────────────────────────────────────────────────────────
HUMAN_APPROVAL_REQUIRED=true

# ── Groq (primary LLM — Gemini is the fallback) ─────────────────────────────────
GROQ_API_KEY_1=gsk_...

# ── Gmail digest delivery (autopilot — primary channel) ─────────────────────────
# Use a Gmail App Password, NOT your real password:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_16_char_app_password
DIGEST_EMAIL_TO=            # defaults to SMTP_USERNAME when empty

# ── Telegram (autopilot daily digest — optional secondary) ──────────────────────
# 1. Message @BotFather → /newbot → copy the token
# 2. Message your new bot once, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy your chat id from the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Autopilot ───────────────────────────────────────────────────────────────────
AUTOPILOT_AT=08:00
